rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isApproved() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          "30copallock@pulaskischools.org",
          "blueberryggames@gmail.com"
        ];
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isApproved()
        && request.resource.data.authorEmail == request.auth.token.email.lower();
      allow update, delete: if isApproved()
        && resource.data.authorEmail == request.auth.token.email.lower();
    }
  }
}
